-      // In that case, the compare can be lowered using xori (since xori has a
-      // 16-bit immediate field), which is cheaper than materializing a vector
-      // constant and using vcmpequb.
-      if (IsPPC64 && Val.ult(1ULL << 16))
-        return false;
